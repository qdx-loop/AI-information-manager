      "html": "<input class=\"ds-input\" placeholder=\"姓名\">",
      "css": ".ds-input{width:100%;box-sizing:border-box;background:var(--colorNeutralBackground1);color:var(--colorNeutralForeground1);border:1px solid var(--colorNeutralStroke1);border-bottom-color:var(--colorNeutralStrokeAccessible);border-radius:var(--borderRadiusMedium);height:32px;padding:0 10px;font-family:var(--fontFamilyBase);font-size:14px}.ds-input::placeholder{color:var(--colorNeutralForeground3);opacity:1}.ds-input:focus-visible{outline:2px solid var(--colorStrokeFocus2);outline-offset:-1px;border-bottom:2px solid var(--colorCompoundBrandStroke)}"
