  "narrative": {
    "northStar": "Fluent Desk · Windows 11 应用工作台",
    "overview": "界面是 Windows 11 风格的应用本身，而不是操作系统模拟：48px Fluent app bar、68px 图标导航、Fluent 2 分层中性面、4/8px 圆角、Segoe 字体。颜色只来自 Fluent 语义 token；品牌蓝色只表达可交互/选中；危险红、警告黄、成功绿只在状态语义中出现。Operate 型产品：扫读效率、状态可预期、键盘可达高于表达欲。",
    "keyCharacteristics": [
      "唯一设计系统 microsoft/fluentui（Fluent UI React v9）",
      "Fluent 2 token 驱动的深浅双主题",
      "应用而非桌面：无壁纸/任务栏/窗口 chrome/锁屏",
      "4px 控件 / 8px 卡片与浮层，克制动效"
    ],
    "rules": [
      {
        "name": "The Fluent Token Rule",
        "body": "所有颜色、圆角、阴影、字体必须来自 Fluent theme token；页面 CSS 不出现独立色值。",
        "section": "colors"
      },
      {
        "name": "The No OS Chrome Rule",
        "body": "不做桌面模拟：无壁纸、任务栏、窗口按钮、桌面图标、锁屏时钟。",
        "section": "layout"
      },
      {
        "name": "The 4/8 Radius Rule",
        "body": "控件 4px（borderRadiusMedium），卡片/浮层/对话框 8px（borderRadiusXLarge），不超过 12px。",
        "section": "shapes"
      },
      {
        "name": "The Two-Theme Rule",
        "body": "深浅主题必须同时成立：正文与占位符 ≥4.5:1，焦点可见，图表/状态色同源。",
        "section": "elevation"
      }
    ],
    "dos": [
      "用 Fluent 组件表达控件，用 Fluent token 表达颜色",
      "保持键盘可达（Ctrl K / Ctrl J / Esc / Tab）与可见焦点",
      "每个可交互组件覆盖 hover/pressed/focus/disabled 四态"
    ],
    "donts": [
      "做操作系统模拟或窗口 chrome",
      "渐变、霓虹、厚投影、自定义 blur、大圆角卡片墙",
      "自创色板或硬编码颜色",
      "为视觉改业务逻辑、字段顺序、快捷键、校验"
    ]
  }
}
