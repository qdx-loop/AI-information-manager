      "html": "<button class=\"ds-btn-subtle\" aria-label=\"刷新\">↻</button>",
      "css": ".ds-btn-subtle{background:transparent;color:var(--colorNeutralForeground2);border:0;border-radius:var(--borderRadiusMedium);width:32px;height:32px;display:inline-flex;align-items:center;justify-content:center;cursor:pointer}.ds-btn-subtle:hover{background:var(--colorSubtleBackgroundHover);color:var(--colorNeutralForeground1)}.ds-btn-subtle:focus-visible{outline:2px solid var(--colorStrokeFocus2);outline-offset:2px}"
