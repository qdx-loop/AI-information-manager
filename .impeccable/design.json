  "narrative": {
    "northStar": "青瓷工作台 · The Celadon Desk",
    "overview": "整个系统像一件青瓷器：釉色是唯一的装饰，器形靠比例与留白立住。蓝绿主色是那层「釉」，界面其余部分是素坯般的白与浅灰，靠发丝线和色调分层区分层次；橙色是「窑火」，只在需要注意力的地方短暂出现。Operate 型产品：扫读效率与状态可预期高于一切表达欲。",
    "keyCharacteristics": ["单一强调色体系", "扁平优先，发丝线分层", "中文优先排版，系统字体回退", "深浅双主题同一套语义"],
    "rules": [
      { "name": "The One Glaze Rule", "body": "蓝绿是唯一的品牌色，负责一切「可点击/已选中」语义。", "section": "colors" },
      { "name": "The Amber Discipline Rule", "body": "琥珀橙只表达行级焦点、内容被修改、临期提醒三件事。", "section": "colors" },
      { "name": "The System-CJK Rule", "body": "任何 font-family 必须携带完整中文回退链；禁止为中文引入网络字体。", "section": "typography" },
      { "name": "The Hairline Rule", "body": "分隔先用 1px 线，再色调差，最后才阴影；禁止自创 box-shadow。", "section": "elevation" }
    ],
    "dos": ["用 #0D9488 表达一切可交互与已选中语义", "时间戳统一 YYYY-MM-DD HH:mm", "复用现有 token", "保持既定断点行为"],
    "donts": ["为中文引入网络字体", "自创 box-shadow、渐变或新的强调色相", "让琥珀橙出现在按钮或大面积背景上", "写死破坏暗色主题的颜色"]
