<!--
    纯 WebView 壳的清单。原本由 bubblewrap 生成 TWA 工程，现在只剩 MainActivity：
    TWA 的 LauncherActivity / DelegationService / FocusActivity / WebViewFallbackActivity /
    FileProvider 与 androidbrowserhelper 依赖已删除（App 直接加载主站，不再走 Chrome 自定义标签页）。

    改动本文件前先读 apk-build/README.md：这里的目标 SDK 与返回键/edge-to-edge 行为绑在一起。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="net.aiim.infodesk">

    <!-- WebView 自己直连主站。原 TWA 依赖的清单合并会带入本权限，删掉依赖后必须显式声明：
         缺失时全部网络请求返回 net::ERR_ACCESS_DENIED，表现为永久白屏。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 导出文件写入公共「下载」目录：Android 10 起改用 MediaStore，不再需要此权限 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name="Application"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/appName"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:usesCleartextTraffic="${usesCleartextTraffic}"
        android:theme="@style/AppTheme">

        <activity
            android:name="MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 点 aiim.de5.net 的链接直接用 App 打开（public/.well-known/assetlinks.json
                 已按本包的签名指纹放行；若哪天想改回「浏览器优先」，删掉下面这段 intent-filter 即可） -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="aiim.de5.net" />
            </intent-filter>
        </activity>
    </application>
</manifest>
